# Environment mode (development or production)
# In production mode, TLS is required
ENVIRONMENT=development

# Logging configuration
# LOG_LEVEL options: debug, info, warn, error
# Defaults to debug in development, info in production
LOG_LEVEL=debug

# Allowed CORS domains (comma-separated)
# For production, use your actual domain(s):
# DOMAINS="https://yourdomain.com"
DOMAINS="http://localhost:8080,http://localhost:5173"

# TLS/HTTPS Configuration (required in production)
# TLS_CERT_FILE=/path/to/cert.pem
# TLS_KEY_FILE=/path/to/key.pem
